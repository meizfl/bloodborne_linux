     	winPtr = winPtr->parentPtr;
+    }
+    /* Cull scrolled-out widgets before starting NanoVG or uploading a mask.
+     * Tk keeps descendants mapped when a canvas moves them off screen. */
+    float visibleLeft = x, visibleTop = y;
+    float visibleRight = x + Tk_Width(childPtr);
+    float visibleBottom = y + Tk_Height(childPtr);
+    float ancestorX = x, ancestorY = y;
+    for (TkWindow *ancestor = childPtr; !Tk_IsTopLevel(ancestor); ) {
+        ancestorX -= ancestor->changes.x;
+        ancestorY -= ancestor->changes.y;
+        ancestor = ancestor->parentPtr;
+        if (visibleLeft < ancestorX) visibleLeft = ancestorX;
+        if (visibleTop < ancestorY) visibleTop = ancestorY;
+        float right = ancestorX + Tk_Width(ancestor);
+        float bottom = ancestorY + Tk_Height(ancestor);
+        if (visibleRight > right) visibleRight = right;
+        if (visibleBottom > bottom) visibleBottom = bottom;
+        if (visibleRight <= visibleLeft || visibleBottom <= visibleTop) {
+            return TCL_ERROR;
+        }
     }
