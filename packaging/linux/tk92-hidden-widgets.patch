     TkWindow *childPtr = TkWaylandTkWindowFromDrawable(drawable);
+    if (!childPtr) return TCL_ERROR;
+    /* Descendants remain mapped in Tk when an ancestor is unmapped. */
+    for (TkWindow *ancestor = childPtr; ancestor; ancestor = ancestor->parentPtr) {
+        if ((ancestor->flags & TK_ALREADY_DEAD) || !Tk_IsMapped(ancestor)) {
+            return TCL_ERROR;
